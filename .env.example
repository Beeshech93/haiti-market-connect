# Backend (généré automatiquement par Lovable Cloud)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bazik — paiements MonCash / NatCash (serveur uniquement, jamais exposés au frontend)
BAZIK_BASE_URL=
BAZIK_API_KEY=
BAZIK_API_SECRET=
BAZIK_WEBHOOK_SECRET=

# Chemins d'API Bazik — à confirmer avec la documentation officielle
BAZIK_PATH_CREATE_PAYMENT=/v1/payments
BAZIK_PATH_GET_PAYMENT=/v1/payments/{id}
BAZIK_PATH_REFUND=/v1/payments/{id}/refund

# URL publique de l'application (retours de paiement et webhooks)
APP_PUBLIC_URL=
