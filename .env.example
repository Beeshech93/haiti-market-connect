# Backend (généré automatiquement par Lovable Cloud)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bazik — paiements MonCash (serveur uniquement, jamais exposés au frontend)
# API: https://api.bazik.io — POST /token, POST /moncash/token, GET /order/{orderId}
BAZIK_BASE_URL=https://api.bazik.io
BAZIK_USER_ID=bzk_xxxxxxxx_0000000000
BAZIK_SECRET_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optionnel — secret partagé si vous signez les webhooks (HMAC-SHA256 du corps brut)
BAZIK_WEBHOOK_SECRET=

# URL publique de l'application (retours de paiement et webhooks)
APP_PUBLIC_URL=
